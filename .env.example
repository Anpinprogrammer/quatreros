# =====================================================================
# Quatreros — variables de entorno (plantilla SIN valores reales)
# Copiar a .env para desarrollo local:  cp .env.example .env
# Nunca versionar .env ni poner secretos en este archivo.
# En staging/producción se configuran en el gestor de variables del hosting.
# =====================================================================

# --- General ---
NODE_ENV=development                 # development | test | staging | production
PORT=3000
APP_BASE_URL=http://localhost:5173   # URL pública de la SPA (CORS y enlaces de correo)
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace
TZ_BUSINESS=America/Bogota           # zona de negocio para fechas (DR-004)

# --- Base de datos (ADR-013: un rol por propósito) ---
# Rol de la aplicación (DML, sin DDL)
DATABASE_URL=postgres://quatreros_app:CAMBIAR@localhost:5432/quatreros
# Rol dueño de esquemas, solo para migraciones (CI/CD y local)
DATABASE_MIGRATIONS_URL=postgres://quatreros_owner:CAMBIAR@localhost:5432/quatreros
DATABASE_SSL=false                   # true en entornos gestionados

# --- Autenticación (Better Auth, ADR-007) ---
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Archivos privados (Cloudflare R2 / S3 compatible) ---
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Correo transaccional (INT-03) ---
MAIL_PROVIDER_API_KEY=
MAIL_FROM=no-responder@example.com

# --- Complemento: asistente Quatreros AI (opcional; ADR-015, ADR-023; ai-architecture §12) ---
# Agente de Anthropic Managed Agents configurado en quatreros-ai/. La activación efectiva se controla
# en BD (platform.addon_settings). El backend aún no lee estas variables (ai-architecture §14).
# La clave vive SOLO en el servidor: nunca en la web, Telegram ni el repositorio. Una clave por entorno.
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_ID=                  # de quatreros-ai/claude-lock.json → ./agents/quatreros-ai.md
ANTHROPIC_AGENT_VERSION=             # vacío = versión más reciente; fijarla en producción
ANTHROPIC_ENVIRONMENT_ID=            # de quatreros-ai/claude-lock.json → ./environments/quatreros-ai-env.yml
ASSISTANT_SESSION_BUDGET_CENTS=      # presupuesto por sesión en centavos de USD (PROPOSED; ai-architecture §7)
# El techo global mensual de IA se configura en BD, no aquí (Q-C-06).

# --- Complemento: Telegram (opcional, ADR-017) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=             # openssl rand -hex 32

# --- Respaldos (deployment-design §4) ---
BACKUP_R2_BUCKET=
BACKUP_AGE_RECIPIENT=                # clave pública age para cifrar los dumps

# Solo pruebas E2E locales/CI: desactiva el límite de intentos de ingreso (rechazado en staging/producción).
# AUTH_RATE_LIMIT_DISABLED=false
