{
  "name": "quatreros",
  "private": true,
  "type": "module",
  "description": "Quatreros — ERP de producción, inventarios, distribución, POS y contabilidad",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @quatreros/api --filter @quatreros/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm run deps:check",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "pnpm --filter @quatreros/api deps:check",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @quatreros/api test:integration",
    "test:e2e": "pnpm --filter @quatreros/web test:e2e",
    "db:generate": "pnpm --filter @quatreros/api db:generate",
    "db:migrate": "pnpm --filter @quatreros/api db:migrate",
    "db:seed": "pnpm --filter @quatreros/api db:seed",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "lefthook install || true",
    "db:seed:demo": "pnpm --filter @quatreros/api db:seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
